{
  "name": "designvault",
  "version": "1.1.2",
  "description": "Visual gallery for AI-generated design files. Browse, organize, and manage HTML/JSX/SVG files from Claude Code, Cursor, and Codex.",
  "bin": {
    "designvault": "./cli.js",
    "dsvault": "./cli.js"
  },
  "files": [
    "cli.js",
    "server/",
    "dist/"
  ],
  "scripts": {
    "build:frontend": "cd frontend && npm install && npm run build",
    "prepare": "npm run build:frontend",
    "test": "node --test server/*.test.js",
    "dev:server": "node cli.js ./test-fixtures",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "keywords": [
    "designvault",
    "design",
    "gallery",
    "html",
    "jsx",
    "svg",
    "ai",
    "claude-code",
    "cursor",
    "codex",
    "developer-tools",
    "preview"
  ],
  "author": "ikhushh7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khushh7/designvault.git"
  },
  "homepage": "https://github.com/khushh7/designvault",
  "bugs": {
    "url": "https://github.com/khushh7/designvault/issues"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fast-glob": "^3.3.2",
    "open": "^10.1.0"
  }
}
